# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env

# Caminho do banco SQLite (arquivo local)
DATABASE_URL="file:./dev.db"

# Segredo usado para assinar os tokens JWT — troque por uma string forte
JWT_SECRET="troque-por-um-segredo-forte"

# Chave de API do Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# Senha dos usuários admin criados pelo seed (obrigatória para rodar o seed)
SEED_ADMIN_PASSWORD=""

# Porta da API (opcional, padrão 3001)
PORT=3001
